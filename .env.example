# Optional. CareLoop runs with no .env at all: a scripted planner and the browser's own speech.
# Copy this file to .env to use the local model (Ollama) and local voice. Everything else has a default.

# Local planner and document reading (ollama pull gemma4:e4b)
LLM_MODEL=gemma4:e4b

# Local voice: remove the # on both lines (models download on first use)
# VOICE=kokoro
# STT=whisper

# Hosted model instead of Ollama: any OpenAI-compatible chat completions endpoint with tool calling.
# The voice planner and document reading both follow CARELOOP_AGENT_LLM. With openai, the text of a shared
# document is sent to that endpoint. To keep documents local, also set CARELOOP_INTAKE_LLM=ollama (and CARELOOP_INTAKE_MODEL).
# CARELOOP_AGENT_LLM=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4.1-mini
