# Optional. CareLoop runs with no .env at all: a scripted planner, pattern-based document reading,
# and the browser's own speech. Copy this file to .env and fill in only what you need.
# Every setting is commented out on purpose: an empty value would replace a working default.
# Keep notes on their own lines; text after a value becomes part of the value.

# ---- CareLoop server ----
# Host and port (default 127.0.0.1 and 8010; the demo script picks a free port near it)
# CARELOOP_HOST=
# CARELOOP_PORT=
# Patient bearer token and demo patient id (synthetic demo values are used when unset)
# CARELOOP_API_TOKEN=
# CARELOOP_DEMO_PATIENT=

# ---- Alexa+ simulator ----
# Host and port (default 127.0.0.1 and 8021; macOS reserves 8021, so it usually opens on 8022)
# CARELOOP_ALEXA_SIM_HOST=
# CARELOOP_ALEXA_SIM_PORT=
# The server's MCP endpoint (the demo script sets it for you)
# CARELOOP_MCP_URL=

# ---- Model standing in for Alexa+'s (voice planner and document reading) ----
# mock (scripted, the default), ollama, or openai: any OpenAI-compatible chat completions endpoint
# with tool calling. With openai, the text of a shared document is sent to that endpoint.
# CARELOOP_AGENT_LLM=
# Endpoint (your provider's /v1 URL, or Ollama at http://127.0.0.1:11434), a tool-calling model, and its key
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# Seconds to wait for a reply
# LLM_TIMEOUT_SECONDS=

# ---- Document reading ----
# Follows CARELOOP_AGENT_LLM. Set ollama to keep documents local, or none for pattern matching only.
# CARELOOP_INTAKE_LLM=
# paddle reads scans and photos; none skips OCR
# CARELOOP_INTAKE_OCR=

# ---- Local voice (models download on first use) ----
# VOICE=kokoro and STT=whisper turn them on
# VOICE=
# STT=
# KOKORO_VOICE=
# KOKORO_SPEED=
# WHISPER_MODEL=
