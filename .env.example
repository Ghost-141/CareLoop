# CareLoop service
CARELOOP_HOST=127.0.0.1
CARELOOP_PORT=8010
CARELOOP_API_TOKEN=careloop-local-demo-token
CARELOOP_DEMO_PATIENT=demo-patient

# Browser voice simulator
CARELOOP_SIM_HOST=127.0.0.1
CARELOOP_SIM_PORT=8020
CARELOOP_MCP_URL=http://127.0.0.1:8010/mcp
CARELOOP_API_URL=http://127.0.0.1:8010/api/care

# mock is deterministic and has no network model dependency.
# Set ollama or openai only when you intentionally configure that provider.
CARELOOP_AGENT_LLM=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:4b-mlx
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=-1

# browser uses built-in browser speech.  Kokoro and Whisper are optional.
VOICE=browser
STT=browser
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
WHISPER_MODEL=mlx-community/whisper-small.en-mlx

# Synthetic caregiver for the same demo patient (defaults to a local token
# only when the local demo patient token is used).
# CARELOOP_CAREGIVER_TOKEN=careloop-local-caregiver-token
# CARELOOP_DEMO_CAREGIVER=demo-caregiver

# Alexa+ behavior simulator (alexa_sim). Uses CARELOOP_AGENT_LLM / LLM_* above;
# mock is the deterministic stage-safe planner.
CARELOOP_ALEXA_SIM_PORT=8021
