# Optional. CareLoop runs with no .env at all: a scripted planner and the browser's own speech.
# Copy this file to .env to use the local model (Ollama) and, if you like, local voice.
# Every other setting has a default; see the Configuration table in the README.

# Local planner and document reading (ollama pull gemma4:e4b)
CARELOOP_AGENT_LLM=ollama
LLM_MODEL=gemma4:e4b

# Local voice: remove the # on both lines (models download on first use)
# VOICE=kokoro
# STT=whisper

# Slow machine? Give the model longer to answer, in seconds (default 60).
# LLM_TIMEOUT_SECONDS=120
